# 公网使用真实域名和HTTPS；管理员和密钥使用 init-env.mjs 生成。
APP_ENV=production
SERVICE_ENV=production
CHAT_IMAGE=human-ai:2.0.0
LOCAL_PORT=8787
PUBLIC_ORIGIN=https://chat.example.com
DOMAIN=chat.example.com
NETWORK_SUBNET=172.31.0.0/24
PROXY_IP=172.31.0.2
ADMIN_USERNAME=operator
ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
METRICS_KEY=REPLACE_WITH_RANDOM_SECRET
MAIL_API_KEY=
MAIL_FROM=
MAIL_CODE_SECRET=
BACKUP_INTERVAL_HOURS=24
ALERT_WEBHOOK=
MIN_FREE_MB=512
MAX_DATA_MB=1024
MAX_RSS_MB=220
